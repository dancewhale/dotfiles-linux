<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.local.gost</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/gost</string>
        <string>-C</string>
        <string>/Users/whale/.config/gost/gost.yml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/whale/Library/Logs/gost/gost.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/whale/Library/Logs/gost/gost-error.log</string>

</dict>
</plist>
