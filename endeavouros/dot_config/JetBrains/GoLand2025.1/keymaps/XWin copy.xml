    <mouse-shortcut keystroke="button4" />
    <keyboard-shortcut first-keystroke="windows" second-keystroke="open_bracket" />
  </action>
  <action id="Forward">
    <mouse-shortcut keystroke="button5" />
    <keyboard-shortcut first-keystroke="windows" second-keystroke="close_bracket" />
  </action>
  <action id="GotoDeclaration">
    <mouse-shortcut keystroke="control button1" />
    <keyboard-shortcut first-keystroke="windows" second-keystroke="b" />
  </action>
</keymap>